<Window x:Class="DataFinder.App.ScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan drives"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <GroupBox Grid.Row="0" Header="Drives to scan" Padding="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" MinHeight="96" MaxHeight="200"
                 ItemsSource="{Binding VolumeChoices}"
                 BorderBrush="#DDDDDD" BorderThickness="1"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <CheckBox Content="{Binding DisplayName}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        ToolTip="Tick every drive that should be read in this run" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="1" Margin="0,6,0,0">
          <TextBlock DockPanel.Dock="Right" Text="{Binding DriveSelectionText}" Foreground="#666666"
                     VerticalAlignment="Center" Margin="8,0,0,0" />
          <Button DockPanel.Dock="Left" Content="Refresh" Style="{StaticResource ToolbarButton}" MinWidth="0" Padding="8,2"
                  Command="{Binding RefreshVolumesCommand}" ToolTip="Look again for mounted NTFS volumes" />
          <Button DockPanel.Dock="Left" Content="Select all" Style="{StaticResource ToolbarButton}" MinWidth="0" Padding="8,2"
                  Command="{Binding SelectAllDrivesCommand}" />
          <Button DockPanel.Dock="Left" Content="Select none" Style="{StaticResource ToolbarButton}" MinWidth="0" Padding="8,2"
                  Command="{Binding SelectNoDrivesCommand}" />
        </DockPanel>
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="1" Header="Rules" Padding="8" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Folder size greater than (MB)"
                   Style="{StaticResource FieldLabel}" Margin="0,2,8,6" />
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,6" Width="90"
                 HorizontalAlignment="Left"
                 Text="{Binding MinSizeText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="More than this many files directly inside"
                   Style="{StaticResource FieldLabel}" Margin="0,0,8,6" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Width="90"
                 HorizontalAlignment="Left"
                 Text="{Binding MinFileCountText, UpdateSourceTrigger=PropertyChanged}" />

        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4"
                  Content="Folder size includes everything in its subfolders"
                  IsChecked="{Binding SizeIncludesSubfolders}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap"
                   Foreground="#B00020" Margin="0,2,0,0"
                   Text="{Binding ValidationMessage}"
                   Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </GroupBox>

    <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" CornerRadius="4"
            Background="#FFF6DA" BorderBrush="#E5C978" BorderThickness="1"
            Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVisibility}}">
      <TextBlock TextWrapping="Wrap"
                 Text="Reading the NTFS master file table needs administrator rights. Close this dialog and restart the app as administrator, otherwise Windows will refuse the scan." />
    </Border>

    <TextBlock Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#666666"
               Text="A folder has to match both rules. Sizes come from the master file table, so they are available without walking the folders." />

    <DockPanel Grid.Row="4" Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Cancel" Style="{StaticResource ToolbarButton}" MinWidth="90" IsCancel="True" />
        <Button Content="Scan" Style="{StaticResource ToolbarButton}" MinWidth="90" IsDefault="True"
                FontWeight="SemiBold" Command="{Binding ScanCommand}" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
