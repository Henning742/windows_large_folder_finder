<Window x:Class="DataFinder.App.DecodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Decode settings"
        Width="980" Height="620" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <GroupBox Grid.Row="0" Header="File types to read as data" Padding="8">
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="File suffixes" Style="{StaticResource FieldLabel}" />
          <Button DockPanel.Dock="Right" Content="Restore defaults" Style="{StaticResource ToolbarButton}"
                  MinWidth="0" Padding="8,2" Command="{Binding ResetExtensionsCommand}"
                  ToolTip="Put the list back to .raw .bin .dat .data" />
          <TextBox Text="{Binding ExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Separate the suffixes with a space, a comma or a semicolon. The dot may be left out." />
        </DockPanel>

        <TextBlock Text="{Binding ExtensionSummary}" Foreground="#666666" TextWrapping="Wrap" Margin="0,6,0,0" />

        <TextBlock Text="{Binding ExtensionsError}" Foreground="#B00020" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding HasExtensionsError, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Foreground="#666666" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Only files with one of these endings are handed to the decoder, and only when nothing else already knows the ending: pictures and text files keep their own preview." />
      </StackPanel>
    </GroupBox>

    <GroupBox Grid.Row="1" Header="Data schematics" Padding="8" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="500" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ListView Grid.Row="0" ItemsSource="{Binding Schemas}"
                    SelectedItem="{Binding SelectedSchema}"
                    BorderBrush="#DDDDDD" BorderThickness="1"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="ToolTip" Value="{Binding Description}" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Show" Width="44">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsShown, Mode=TwoWay}" VerticalAlignment="Center"
                                ToolTip="Tick to draw this schematic in the all-at-once view" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Name" Width="206" DisplayMemberBinding="{Binding ListName}" />
                <GridViewColumn Header="Frame" Width="100" DisplayMemberBinding="{Binding SizeText}" />
                <GridViewColumn Header="Data type" Width="130" DisplayMemberBinding="{Binding DataTypeText}" />
              </GridView>
            </ListView.View>
          </ListView>

          <WrapPanel Grid.Row="1" Margin="0,6,0,0">
            <Button Content="Add" Style="{StaticResource ToolbarButton}" MinWidth="0" Padding="8,2"
                    Command="{Binding AddSchemaCommand}" ToolTip="Start a schematic from scratch" />
            <Button Content="Duplicate" Style="{StaticResource ToolbarButton}" MinWidth="0" Padding="8,2"
                    Command="{Binding DuplicateSchemaCommand}"
                    ToolTip="Start from the ticked schematic, so only the difference has to be typed" />
            <Button Content="Remove" Style="{StaticResource ToolbarButton}" MinWidth="0" Padding="8,2"
                    Command="{Binding RemoveSchemaCommand}" />
            <Button Content="Tick all" Style="{StaticResource ToolbarButton}" MinWidth="0" Padding="8,2"
                    Command="{Binding ShowAllSchemasCommand}"
                    ToolTip="Draw every schematic in the all-at-once view" />
            <Button Content="Tick none" Style="{StaticResource ToolbarButton}" MinWidth="0" Padding="8,2"
                    Command="{Binding ShowNoSchemasCommand}" />
            <Button Content="Restore the built-in ones" Style="{StaticResource ToolbarButton}"
                    MinWidth="0" Padding="8,2" Command="{Binding RestoreSchematicsCommand}" />
          </WrapPanel>
        </Grid>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel DataContext="{Binding SelectedSchema}">
            <TextBlock Text="Selected schematic" Style="{StaticResource PaneHeader}" Margin="0,0,0,6" />

            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

            <TextBlock Text="Frame size (pixels)" Style="{StaticResource FieldLabel}" />
            <DockPanel Margin="0,0,0,6">
              <TextBox DockPanel.Dock="Left" Width="70"
                       Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Width of one frame" />
              <TextBlock DockPanel.Dock="Left" Text="x" Style="{StaticResource FieldLabel}" Margin="6,0" />
              <TextBox DockPanel.Dock="Left" Width="70"
                       Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Height of one frame" />
              <Border />
            </DockPanel>

            <TextBlock Text="Header in front of every frame (bytes)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding HeaderLengthText, UpdateSourceTrigger=PropertyChanged}" Width="70"
                     HorizontalAlignment="Left" Margin="0,0,0,6"
                     ToolTip="Bytes per frame that are not pixels. 0 when the file has no header." />

            <TextBlock Text="Data type" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding DataTypes}" DisplayMemberPath="Text"
                      SelectedValuePath="DataType" SelectedValue="{Binding DataType}"
                      Margin="0,0,0,4" />

            <CheckBox Content="Stretch the values to the full 0-255 range"
                      IsChecked="{Binding Normalize}" IsEnabled="{Binding CanNormalize}"
                      ToolTip="The darkest 2% of the frame go black and the brightest 2% go white. Only 16 bit data can be stretched." />

            <TextBlock Text="Crop: rows and columns to throw away" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
            <TextBox Text="{Binding BordersText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Top, bottom, left, right - for example 1,1,0,0. Leave it empty for no crop." />

            <TextBlock Text="Packed 8 bit part starts at column" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
            <TextBox Text="{Binding SplitColumnText, UpdateSourceTrigger=PropertyChanged}" Width="70"
                     HorizontalAlignment="Left"
                     ToolTip="Only used by 16 bit + packed 8 bit. 0 means the middle of the frame." />

            <TextBlock Text="Frame to show" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
            <TextBox Text="{Binding FrameIndexText, UpdateSourceTrigger=PropertyChanged}" Width="70"
                     HorizontalAlignment="Left"
                     ToolTip="Which frame of the recording to show. 0 is the first one." />

            <CheckBox Content="Remove the white speckle" IsChecked="{Binding RemoveWhite}" Margin="0,8,0,0"
                      ToolTip="Replace the white dots some cameras leave behind with the neighbouring sample." />

            <TextBlock Text="{Binding ValidationMessage}" Foreground="#B00020" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </GroupBox>

    <TextBlock Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#666666"
               Text="A schematic that cannot be read is left out of the preview. The one a data file is read with is picked in the preview pane." />

    <DockPanel Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Right">
      <Button Content="Close" Style="{StaticResource ToolbarButton}" MinWidth="90" IsDefault="True" IsCancel="True" />
    </DockPanel>
  </Grid>
</Window>
