<Window x:Class="DataFinder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NTFS Folder Finder"
        Height="820" Width="1440" MinHeight="560" MinWidth="1024"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="8">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Button Content="Scan" Style="{StaticResource ToolbarButton}" FontWeight="SemiBold" Command="{Binding ScanCommand}" />
          <Button Content="Cancel" Style="{StaticResource ToolbarButton}" Command="{Binding CancelCommand}" />
          <TextBlock Text="{Binding DriveSelectionText}" Style="{StaticResource FieldLabel}" Margin="8,0,8,0" Foreground="#666666" />
          <Button Content="Refresh" Style="{StaticResource ToolbarButton}" Command="{Binding RefreshVolumesCommand}" />
          <Border Width="14" />
          <Button Content="Import..." Style="{StaticResource ToolbarButton}" Command="{Binding ImportCommand}" />
          <Button Content="Export..." Style="{StaticResource ToolbarButton}" Command="{Binding ExportCommand}" />
          <Button Content="Clear" Style="{StaticResource ToolbarButton}" Command="{Binding ClearResultsCommand}" />
        </StackPanel>
        <ProgressBar Height="17" Margin="16,0,0,0" VerticalAlignment="Center"
                     Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
      </DockPanel>
    </Border>

    <!-- Elevation hint and scan warnings -->
    <StackPanel Grid.Row="1">
      <Border Margin="0,8,0,0" Padding="10" CornerRadius="4"
              Background="#FFF6DA" BorderBrush="#E5C978" BorderThickness="1"
              Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}"
                  Content="Restart as administrator" Command="{Binding RelaunchElevatedCommand}" />
          <TextBlock TextWrapping="Wrap"
                     Text="Reading the NTFS master file table needs administrator rights. Restart the app elevated, otherwise Windows will refuse the scan." />
        </DockPanel>
      </Border>

      <Border Margin="0,8,0,0" Padding="10" CornerRadius="4"
              Background="#FDE7E9" BorderBrush="#B00020" BorderThickness="1"
              Visibility="{Binding HasScanWarning, Converter={StaticResource BoolToVisibility}}">
        <TextBlock TextWrapping="Wrap" Foreground="#B00020" FontWeight="SemiBold"
                   Text="{Binding ScanWarning}" />
      </Border>
    </StackPanel>

    <Grid Grid.Row="2" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="480" MinWidth="340" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" MinWidth="380" />
      </Grid.ColumnDefinitions>

      <!-- Left pane: rules and results -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Drives to scan" Padding="8">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" x:Name="DriveList" MaxHeight="104"
                     ItemsSource="{Binding VolumeChoices}"
                     IsEnabled="{Binding IsNotScanning}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding DisplayName}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            ToolTip="Tick every drive that should be scanned in the next run" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
              <Button Content="Select all" Style="{StaticResource ToolbarButton}" MinWidth="0" Padding="8,2"
                      Command="{Binding SelectAllDrivesCommand}" />
              <Button Content="Select none" Style="{StaticResource ToolbarButton}" MinWidth="0" Padding="8,2"
                      Command="{Binding SelectNoDrivesCommand}" />
            </StackPanel>
          </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Rules" Padding="8" Margin="0,8,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Folder size greater than (MB)"
                       Style="{StaticResource FieldLabel}" Margin="0,2,8,6" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,6" Width="90"
                     HorizontalAlignment="Left"
                     Text="{Binding MinSizeText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsNotScanning}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="More than this many files directly inside"
                       Style="{StaticResource FieldLabel}" Margin="0,0,8,6" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Width="90"
                     HorizontalAlignment="Left"
                     Text="{Binding MinFileCountText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsNotScanning}" />

            <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4"
                      Content="Folder size includes everything in its subfolders"
                      IsChecked="{Binding SizeIncludesSubfolders}"
                      IsEnabled="{Binding IsNotScanning}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap"
                       Foreground="#B00020" Margin="0,2,0,2"
                       Text="{Binding ValidationMessage}"
                       Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap"
                       Foreground="#666666" Margin="0,4,0,0"
                       Text="A folder has to match both rules. Sizes come from the master file table, so they are available without walking the folders." />
          </Grid>
        </GroupBox>

        <DockPanel Grid.Row="2" Margin="0,10,0,4">
          <TextBlock DockPanel.Dock="Left" Text="Results" Style="{StaticResource PaneHeader}" />
          <TextBlock DockPanel.Dock="Right" Text="{Binding ResultSummary}" Foreground="#666666"
                     VerticalAlignment="Center" Margin="8,0,0,0" />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Expand all" Style="{StaticResource ToolbarButton}" MinWidth="0" Padding="6,2"
                    Command="{Binding ExpandAllCommand}" ToolTip="Show every folder in the tree" />
            <Button Content="Collapse all" Style="{StaticResource ToolbarButton}" MinWidth="0" Padding="6,2"
                    Command="{Binding CollapseAllCommand}" ToolTip="Hide everything below the drives" />
          </StackPanel>
          <TextBox Margin="12,0,12,0" VerticalAlignment="Center"
                   Text="{Binding ResultFilter, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Show only folders whose path contains this text" />
        </DockPanel>

        <ListView x:Name="ResultsList" Grid.Row="3"
                  ItemsSource="{Binding VisibleResults}"
                  SelectedItem="{Binding SelectedResultNode}"
                  MouseDoubleClick="ResultsList_MouseDoubleClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="ToolTip" Value="{Binding DetailText}" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Folder" Width="250">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="{Binding Depth, Converter={StaticResource DepthToIndent}}">
                      <ToggleButton Style="{StaticResource TreeExpanderToggle}"
                                    IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                    Visibility="{Binding HasChildren, Converter={StaticResource BoolToHiddenVisibility}}" />
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsMatch}" Value="False">
                                <Setter Property="FontWeight" Value="Normal" />
                                <Setter Property="Foreground" Value="#777777" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Size" Width="78" DisplayMemberBinding="{Binding SizeText}" />
              <GridViewColumn Header="Files" Width="54" DisplayMemberBinding="{Binding FilesText}" />
              <GridViewColumn Header="Subdirs" Width="58" DisplayMemberBinding="{Binding SubfolderText}" />
            </GridView>
          </ListView.View>
        </ListView>
      </Grid>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" Background="#EEEEEE" />

      <!-- Right pane: contents of the selected folder and a preview of the selected item -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="2*" MinHeight="120" />
          <RowDefinition Height="8" />
          <RowDefinition Height="1.3*" MinHeight="120" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Content="Up" Style="{StaticResource ToolbarButton}" Command="{Binding NavigateUpCommand}" />
            <Button Content="Open in Explorer" Style="{StaticResource ToolbarButton}" Command="{Binding OpenFolderCommand}" />
            <Button Content="Copy path" Style="{StaticResource ToolbarButton}" Command="{Binding CopyPathCommand}" />
            <Button Content="Open file" Style="{StaticResource ToolbarButton}" Command="{Binding OpenContentCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="On opening a folder, select" Style="{StaticResource FieldLabel}" />
            <ComboBox Width="118" VerticalAlignment="Center"
                      ItemsSource="{Binding AutoSelectOptions}"
                      DisplayMemberPath="Text"
                      SelectedValuePath="Mode"
                      SelectedValue="{Binding AutoSelectMode}"
                      ToolTip="The file the right pane selects on its own as soon as a folder is opened" />
          </StackPanel>
          <TextBlock Text="{Binding ActiveFolderPath}" Style="{StaticResource PaneHeader}"
                     TextTrimming="CharacterEllipsis" ToolTip="{Binding ActiveFolderPath}" />
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,6,0,0" IsEnabled="{Binding HasSelectedFolder}">
          <TextBlock DockPanel.Dock="Left" Text="Comment" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding SelectedComment, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding HasSelectedFolder}"
                   ToolTip="A note about the selected folder. Exported in the Comment column of the CSV and read back on import." />
        </DockPanel>

        <Border Grid.Row="2" Margin="0,6,0,0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
          <ListView x:Name="ContentsList"
                    ItemsSource="{Binding Contents}"
                    SelectedItem="{Binding SelectedContent}"
                    MouseDoubleClick="ContentsList_MouseDoubleClick"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Name" Width="320">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Type" Width="70" DisplayMemberBinding="{Binding TypeText}" />
                <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                <GridViewColumn Header="Items" Width="70" DisplayMemberBinding="{Binding ChildCountText}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Border>

        <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" Background="#EEEEEE" />

        <Border Grid.Row="4" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
          <Grid>
            <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="8"
                   StretchDirection="DownOnly"
                   Visibility="{Binding IsImagePreviewVisible, Converter={StaticResource BoolToVisibility}}" />
            <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                     BorderThickness="0" Background="Transparent" Margin="6"
                     FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Visibility="{Binding IsTextPreviewVisible, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding PreviewMessage}" TextWrapping="Wrap" Margin="12"
                       Foreground="#555555" VerticalAlignment="Top"
                       Visibility="{Binding IsMessageVisible, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Status bar -->
    <DockPanel Grid.Row="3" Margin="0,8,0,0">
      <TextBlock DockPanel.Dock="Right" Text="{Binding ResultSummary}" Foreground="#666666" Margin="12,0,0,0" />
      <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
    </DockPanel>
  </Grid>
</Window>
