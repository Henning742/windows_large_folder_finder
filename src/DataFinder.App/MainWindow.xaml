<Window x:Class="DataFinder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="820" Width="1440" MinHeight="560" MinWidth="1024"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="8">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Button Content="Scan..." Style="{StaticResource ToolbarButton}" FontWeight="SemiBold"
                  Click="ScanButton_Click" IsEnabled="{Binding IsNotScanning}"
                  ToolTip="Choose the drives to read and the rules to apply" />
          <Button Content="Cancel" Style="{StaticResource ToolbarButton}" Command="{Binding CancelCommand}" />
          <Border Width="14" />
          <Button Content="Import..." Style="{StaticResource ToolbarButton}" Command="{Binding ImportCommand}" />
          <Button Content="Export..." Style="{StaticResource ToolbarButton}" Command="{Binding ExportCommand}" />
          <Button Content="Web page..." Style="{StaticResource ToolbarButton}" Command="{Binding ExportWebPageCommand}"
                  ToolTip="Write every folder in the list, with a few thumbnails of what is inside each, to one HTML file" />
          <Button Content="Clear" Style="{StaticResource ToolbarButton}" Command="{Binding ClearResultsCommand}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}" MinWidth="150" Margin="12,0,0,0"
                   VerticalAlignment="Center" TextAlignment="Right" Foreground="#0A66C2" />
        <ProgressBar Height="17" Margin="16,0,0,0" VerticalAlignment="Center"
                     Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
      </DockPanel>
    </Border>

    <!-- Elevation hint and scan warnings -->
    <StackPanel Grid.Row="1">
      <Border Margin="0,8,0,0" Padding="10" CornerRadius="4"
              Background="#FFF6DA" BorderBrush="#E5C978" BorderThickness="1"
              Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}"
                  Content="Restart as administrator" Command="{Binding RelaunchElevatedCommand}" />
          <TextBlock TextWrapping="Wrap"
                     Text="Reading the NTFS master file table needs administrator rights. Restart the app elevated, otherwise Windows will refuse the scan." />
        </DockPanel>
      </Border>

      <Border Margin="0,8,0,0" Padding="10" CornerRadius="4"
              Background="#FDE7E9" BorderBrush="#B00020" BorderThickness="1"
              Visibility="{Binding HasScanWarning, Converter={StaticResource BoolToVisibility}}">
        <TextBlock TextWrapping="Wrap" Foreground="#B00020" FontWeight="SemiBold"
                   Text="{Binding ScanWarning}" />
      </Border>
    </StackPanel>

    <Grid Grid.Row="2" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="600" MinWidth="340" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" MinWidth="380" />
      </Grid.ColumnDefinitions>

      <!-- Left pane: rules and results -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,4">
          <TextBlock DockPanel.Dock="Left" Text="Results" Style="{StaticResource PaneHeader}" />
          <TextBlock DockPanel.Dock="Right" Text="{Binding ResultSummary}" Foreground="#666666"
                     VerticalAlignment="Center" Margin="8,0,0,0" />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Expand all" Style="{StaticResource ToolbarButton}" MinWidth="0" Padding="6,2"
                    Command="{Binding ExpandAllCommand}" ToolTip="Show every folder in the tree" />
            <Button Content="Collapse all" Style="{StaticResource ToolbarButton}" MinWidth="0" Padding="6,2"
                    Command="{Binding CollapseAllCommand}" ToolTip="Hide everything below the drives" />
          </StackPanel>
          <TextBox Margin="12,0,12,0" VerticalAlignment="Center"
                   Text="{Binding ResultFilter, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Show only folders whose path contains this text" />
        </DockPanel>

        <ListView x:Name="ResultsList" Grid.Row="1"
                  ItemsSource="{Binding VisibleResults}"
                  SelectedItem="{Binding SelectedResultNode}"
                  MouseDoubleClick="ResultsList_MouseDoubleClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="ToolTip" Value="{Binding DetailText}" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Folder" Width="240">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <Grid Margin="{Binding Depth, Converter={StaticResource DepthToIndent}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <ToggleButton Style="{StaticResource TreeExpanderToggle}"
                                    IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                    Visibility="{Binding HasChildren, Converter={StaticResource BoolToHiddenVisibility}}" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" ToolTip="{Binding DetailText}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsMatch}" Value="False">
                                <Setter Property="FontWeight" Value="Normal" />
                                <Setter Property="Foreground" Value="#777777" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Comment" Width="170">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Comment}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="#555555" ToolTip="{Binding Comment}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Size" Width="76" DisplayMemberBinding="{Binding SizeText}" />
              <GridViewColumn Header="Files" Width="54" DisplayMemberBinding="{Binding FilesText}" />
              <GridViewColumn Header="Subdirs" Width="58" DisplayMemberBinding="{Binding SubfolderText}" />
            </GridView>
          </ListView.View>
        </ListView>
      </Grid>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" Background="#EEEEEE" />

      <!-- Right pane: either one folder's contents, or every folder of the list at once -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
          <!-- What the pane shows. The two panes below it are drawn one at a time. -->
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="Right pane" Style="{StaticResource FieldLabel}" />
            <ComboBox Width="184" VerticalAlignment="Center"
                      ItemsSource="{Binding RightPaneOptions}"
                      DisplayMemberPath="Text"
                      SelectedValuePath="Mode"
                      SelectedValue="{Binding RightPane}"
                      ToolTip="What the right pane shows: the contents of the folder picked on the left, or every folder of the list at once with a few pictures of what is inside each of them" />
          </StackPanel>

          <!-- The rest of this row belongs to the contents pane, which is the one with one folder in it. -->
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                      Visibility="{Binding IsContentsPaneVisible, Converter={StaticResource BoolToVisibility}}">
            <Button Content="Up" Style="{StaticResource ToolbarButton}" Command="{Binding NavigateUpCommand}" />
            <Button Content="Open in Explorer" Style="{StaticResource ToolbarButton}" Command="{Binding OpenFolderCommand}" />
            <Button Content="Copy path" Style="{StaticResource ToolbarButton}" Command="{Binding CopyPathCommand}" />
            <Button Content="Open file" Style="{StaticResource ToolbarButton}" Command="{Binding OpenContentCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                      Visibility="{Binding IsContentsPaneVisible, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="On opening a folder, select" Style="{StaticResource FieldLabel}" />
            <ComboBox Width="118" VerticalAlignment="Center"
                      ItemsSource="{Binding AutoSelectOptions}"
                      DisplayMemberPath="Text"
                      SelectedValuePath="Mode"
                      SelectedValue="{Binding AutoSelectMode}"
                      ToolTip="The file the right pane selects on its own as soon as a folder is opened" />
          </StackPanel>

          <Grid>
            <TextBlock Text="{Binding ActiveFolderPath}" Style="{StaticResource PaneHeader}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ActiveFolderPath}"
                       Visibility="{Binding IsContentsPaneVisible, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="Every folder, with a few pictures of what is inside each of them"
                       Style="{StaticResource PaneHeader}" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding IsGalleryVisible, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
        </DockPanel>

        <!-- The contents of the folder picked on the left, and a preview of the file picked here -->
        <Grid Grid.Row="1" Margin="0,6,0,0"
              Visibility="{Binding IsContentsPaneVisible, Converter={StaticResource BoolToVisibility}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="120" />
            <RowDefinition Height="8" />
            <RowDefinition Height="1.3*" MinHeight="120" />
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0">
            <TextBlock DockPanel.Dock="Left" Text="Comment" Style="{StaticResource FieldLabel}" />
            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="#B26A00" FontWeight="SemiBold"
                       Text="not exported yet"
                       ToolTip="Export writes the notes into the comment column of the CSV report. Until then they only live in this window."
                       Visibility="{Binding HasUnsavedComments, Converter={StaticResource BoolToVisibility}}" />
            <TextBox Text="{Binding SelectedComment, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding HasSelectedFolder}"
                     ToolTip="A note about the selected folder. Export writes it to the Comment column of the CSV; import reads it back." />
          </DockPanel>

          <Border Grid.Row="1" Margin="0,6,0,0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
            <ListView x:Name="ContentsList"
                      ItemsSource="{Binding Contents}"
                      SelectedItem="{Binding SelectedContent}"
                      MouseDoubleClick="ContentsList_MouseDoubleClick"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Name" Width="320">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Type" Width="70" DisplayMemberBinding="{Binding TypeText}" />
                  <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                  <GridViewColumn Header="Items" Width="70" DisplayMemberBinding="{Binding ChildCountText}" />
                </GridView>
              </ListView.View>
            </ListView>
          </Border>

          <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch"
                        VerticalAlignment="Center" Background="#EEEEEE" />

          <Border Grid.Row="3" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!-- How a data file is read, and where the rest of the decode settings live -->
              <DockPanel Grid.Row="0" Margin="8,5,6,0">
                <Button DockPanel.Dock="Right" Content="Decode settings..." Style="{StaticResource ToolbarButton}"
                        MinWidth="0" Padding="8,2" Click="DecodeSettingsButton_Click"
                        ToolTip="Which file types are read as data, and the schematics that are on offer" />
                <WrapPanel Orientation="Horizontal">
                  <TextBlock Text="Preview" Style="{StaticResource PaneHeader}" Margin="0,0,12,0" />
                  <TextBlock Text="Schematic" Style="{StaticResource FieldLabel}" />
                  <ComboBox Width="220" VerticalAlignment="Center"
                            ItemsSource="{Binding PreviewSchemas}"
                            DisplayMemberPath="Name"
                            SelectedItem="{Binding SelectedPreviewSchema}"
                            IsEnabled="{Binding IsSingleSchematicMode}"
                            ToolTip="{Binding SelectedPreviewSchema.Description}" />
                  <CheckBox Content="Show all ticked" VerticalAlignment="Center" Margin="12,0,0,0"
                            IsChecked="{Binding ShowAllSchematics}"
                            ToolTip="Draw the selected data file through every schematic that is ticked in Decode settings, side by side, instead of only the one in the drop down" />
                  <TextBlock Text="{Binding AllSchematicsSummary}" Foreground="#666666" VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             Visibility="{Binding ShowAllSchematics, Converter={StaticResource BoolToVisibility}}" />
                  <CheckBox Content="Stretch" VerticalAlignment="Center" Margin="12,0,0,0"
                            IsChecked="{Binding StretchPreview}" IsEnabled="{Binding CanStretchPreview}"
                            ToolTip="Pin the darkest 2% of the frame to black and the brightest 2% to white. 16 bit recordings start stretched, because otherwise they are nearly black; 8 bit ones start as they are. This tick flips it for the look on screen." />
                </WrapPanel>
              </DockPanel>

              <Grid Grid.Row="1">
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="8"
                       StretchDirection="DownOnly"
                       Visibility="{Binding IsImagePreviewVisible, Converter={StaticResource BoolToVisibility}}" />

                <!-- One picture per schematic, so several ways of reading the same file can be compared -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsTilePreviewVisible, Converter={StaticResource BoolToVisibility}}">
                  <ItemsControl ItemsSource="{Binding PreviewTiles}" Margin="4">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="4" Padding="5" CornerRadius="3" Background="White"
                                BorderBrush="#DDDDDD" BorderThickness="1">
                          <StackPanel MaxWidth="400">
                            <TextBlock Text="{Binding Caption}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Caption}" />
                            <TextBlock Text="{Binding Detail}" Foreground="#666666" FontSize="11"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                            <Image Source="{Binding Image}" MaxHeight="210" Margin="0,3,0,0"
                                   Stretch="Uniform" StretchDirection="DownOnly"
                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Message}" Foreground="#B00020" TextWrapping="Wrap"
                                       MaxWidth="390" Margin="0,3,0,0"
                                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                         BorderThickness="0" Background="Transparent" Margin="6"
                         FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Visibility="{Binding IsTextPreviewVisible, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding PreviewMessage}" TextWrapping="Wrap" Margin="12"
                           Foreground="#555555" VerticalAlignment="Top"
                           Visibility="{Binding IsMessageVisible, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <!-- Every folder of the list at once, each with a few pictures of what is inside it -->
        <Grid Grid.Row="1" Margin="0,6,0,0"
              Visibility="{Binding IsGalleryVisible, Converter={StaticResource BoolToVisibility}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Gather again" Style="{StaticResource ToolbarButton}"
                    Command="{Binding RefreshGalleryCommand}"
                    ToolTip="Pick a fresh set of pictures for every folder. The pictures are picked at random, so two runs show different ones; the folders on screen are read again straight away." />
            <TextBlock Text="{Binding GallerySummary}" Foreground="#666666" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding GallerySummary}" />
          </DockPanel>

          <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Background="#FFFFFF">
            <ListBox x:Name="GalleryList" ItemsSource="{Binding GalleryFolders}" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.ScrollChanged="GalleryList_ScrollChanged"
                     Loaded="GalleryList_Loaded" SizeChanged="GalleryList_SizeChanged"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.ItemContainerStyle>
                <!-- The cards are read rather than picked, so a row has no selection of its own. -->
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <!-- Every card is the same height: each line is one line and the row of pictures is
                       one row of one height, so the list can be measured - and the bar on the right
                       be right - before any of the pictures have been found. -->
                  <Border Margin="8,8,8,0" Padding="10" CornerRadius="4"
                          Background="#FAFBFC" BorderBrush="#E3E6EA" BorderThickness="1">
                    <Grid>
                      <Grid.RowDefinitions>
                        <!-- The row with the name holds the button as well, so its height comes from
                             the two of them - the same on every card. -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="20" />
                        <!-- The row of pictures keeps its height whether a folder has any yet, which
                             is what makes every card the same height from the moment it goes up. -->
                        <RowDefinition Height="196" />
                        <RowDefinition Height="18" />
                      </Grid.RowDefinitions>

                      <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" Content="Show in the tree" MinWidth="0" Padding="6,2"
                                Style="{StaticResource ToolbarButton}"
                                Command="{Binding DataContext.ShowInTreeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                ToolTip="Pick this folder in the list on the left and go back to showing one folder at a time" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                      </DockPanel>

                      <TextBlock Grid.Row="1" Text="{Binding FullPath}" FontSize="11" Foreground="#666666"
                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />

                      <!-- One line each, the whole of it in the tooltip: the card keeps the height it
                           had whether a folder has a note or not. -->
                      <TextBlock Grid.Row="2" Text="{Binding Summary}" Foreground="#4B5563"
                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
                      <TextBlock Grid.Row="3" Text="{Binding Comment}" Foreground="#6B7280"
                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Comment}" />

                      <Grid Grid.Row="4" Margin="0,4,0,0">
                        <!-- The row of pictures: one line, as wide as the card, scrolling sideways when
                             the card holds more than the width takes. -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasPictures, Converter={StaticResource BoolToVisibility}}">
                          <ItemsControl ItemsSource="{Binding Pictures}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Margin="0,0,8,0" Padding="5" CornerRadius="4" Background="#FFFFFF"
                                        BorderBrush="#E3E6EA" BorderThickness="1" Cursor="Hand"
                                        MouseLeftButtonDown="GalleryPicture_MouseLeftButtonDown"
                                        ToolTip="{Binding Hint}">
                                  <StackPanel Width="220">
                                    <Border Background="#111111" CornerRadius="3">
                                      <Image Source="{Binding Thumbnail}" Width="210" Height="120" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Text="{Binding Caption}" FontSize="12" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Caption}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#6B7280"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>

                        <!-- Where the pictures have not been found yet, or will not be: the card says
                             which rather than leaving the space empty and unexplained. -->
                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
                      </Grid>

                      <TextBlock Grid.Row="5" Text="{Binding Note}" FontSize="11" Foreground="#6B7280"
                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"
                                 Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- Status bar -->
    <DockPanel Grid.Row="3" Margin="0,8,0,0">
      <TextBlock DockPanel.Dock="Right" Text="{Binding ResultSummary}" Foreground="#666666" Margin="12,0,0,0" />
      <TextBlock DockPanel.Dock="Right" Text="{Binding ScanSummary}" Foreground="#666666" Margin="12,0,0,0"
                 TextTrimming="CharacterEllipsis" MaxWidth="560" ToolTip="{Binding ScanSummary}" />
      <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
    </DockPanel>
  </Grid>
</Window>
